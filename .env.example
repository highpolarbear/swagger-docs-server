# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# ---- Docs sign-in through Nextcloud ----------------------------------------
# oidc             = Nextcloud with the "OIDC Identity Provider" app (recommended)
# nextcloud-oauth2 = Nextcloud's built-in OAuth 2.0 (no app needed)
# none             = no sign-in, local development only
AUTH_MODE=oidc

# The address people open in their browser for the docs (no trailing slash).
# With Cloudflare Tunnel, this is the public hostname you set up, e.g. https://docs.example.com
# Register PUBLIC_URL + /auth/callback as the redirect URI in Nextcloud.
PUBLIC_URL=https://docs.example.com

# Your Nextcloud address (no trailing slash).
NEXTCLOUD_URL=https://cloud.example.com

# Only for AUTH_MODE=oidc, if discovery at NEXTCLOUD_URL fails:
# OIDC_ISSUER=https://cloud.example.com/index.php
# Add "groups" here if your OIDC app needs it to send group membership:
# OIDC_SCOPES=openid profile email

# From the client you create in Nextcloud.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Who may read the docs (comma-separated Nextcloud user IDs and/or group names).
# If both are empty, EVERY Nextcloud user can sign in.
ALLOWED_GROUPS=api-team
ALLOWED_USERS=

# Signs the login cookie. Changing it signs everyone out.
SESSION_SECRET=
SESSION_HOURS=12

# ---- Machine access ------------------------------------------------------------
# Lets Claude edit the spec through /mcp. Required.
MCP_TOKEN=

# Optional: lets a CI build download /openapi.yaml without a browser login,
# using the header "Authorization: Bearer <SPEC_READ_TOKEN>". Read-only.
SPEC_READ_TOKEN=
