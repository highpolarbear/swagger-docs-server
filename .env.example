# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# ---- Docs sign-in ------------------------------------------------------------
# none             = no sign-in in this server. Use behind Pomerium (or another authenticating proxy)
#                    that only lets allowed people through. The Nextcloud settings below are then ignored.
# oidc             = Nextcloud with the "OIDC Identity Provider" app
# nextcloud-oauth2 = Nextcloud's built-in OAuth 2.0 (no app needed)
AUTH_MODE=none

# The address people open in their browser for the docs (no trailing slash).
# With Pomerium or Cloudflare Tunnel, this is the public hostname, e.g. https://docs.example.com
PUBLIC_URL=https://docs.example.com

# ---- Only for AUTH_MODE=oidc or nextcloud-oauth2 -------------------------------
# Register PUBLIC_URL + /auth/callback as the redirect URI in Nextcloud.
NEXTCLOUD_URL=https://cloud.example.com

# Only for AUTH_MODE=oidc, if discovery at NEXTCLOUD_URL fails:
# OIDC_ISSUER=https://cloud.example.com/index.php
# Add "groups" here if your OIDC app needs it to send group membership:
# OIDC_SCOPES=openid profile email

# From the client you create in Nextcloud.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Who may read the docs (comma-separated Nextcloud user IDs and/or group names).
# If both are empty, EVERY Nextcloud user can sign in.
ALLOWED_GROUPS=api-team
ALLOWED_USERS=

# Signs the login cookie. Changing it signs everyone out.
SESSION_SECRET=
SESSION_HOURS=12

# ---- Machine access ------------------------------------------------------------
# Lets Claude edit the spec through /mcp. Required, in every AUTH_MODE.
MCP_TOKEN=

# Optional: lets a CI build download /openapi.yaml, /openapi.json and /export/ts-stubs.zip without a
# browser login, using the header "Authorization: Bearer <SPEC_READ_TOKEN>". Read-only.
# Not needed with AUTH_MODE=none (those URLs are then open to anyone who gets past the proxy).
SPEC_READ_TOKEN=

# ---- Cloudflare Tunnel (optional) ----------------------------------------------
# Paste the token Cloudflare shows when you create the tunnel (the long string after --token).
# Leave it empty and docker compose doesn't start the tunnel at all.
TUNNEL_TOKEN=
