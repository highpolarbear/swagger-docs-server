{
  "name": "swagger-docs-server",
  "version": "2.0.0",
  "description": "Standalone Swagger UI docs server with an MCP endpoint for editing the OpenAPI spec",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cookie-session": "2.1.1",
    "express": "4.22.3",
    "openapi-typescript": "7.13.0",
    "openid-client": "6.8.8",
    "swagger-ui-dist": "5.17.14",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "yazl": "3.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/cookie-session": "2.0.49",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/swagger-ui-dist": "3.30.6",
    "@types/yazl": "3.3.1",
    "tsx": "4.23.15"
  }
}
